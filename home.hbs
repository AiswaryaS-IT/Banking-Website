<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Banking Website</title>
</head>
<body>
    <div class="container">
        <h1 style="text-align: center;">Welcome to SwiftBank</h1>
        <div class="login">
            <h2>Login</h2>
            <form id="loginForm" action="/home" method="POST">
                <input type="text" id="accountNumber" placeholder="Account Number" name="account_number" required><br><br>
                <input type="text" id="mobileNumber" placeholder="Mobile Number" name="phone" required><br><br>
                <button type="submit">Login</button>
            </form><br><br>
            <p style="text-align: center;">Don't have an account? <a href="/register">Register</a></p>
        </div>
    </div>
</body>
</html>
